{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "tools/**",
      "node_modules/**",
      "serve.py",
      "README.md",
      "*.png",
      "*.PNG",
      "mockup.html"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
